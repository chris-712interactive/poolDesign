# Postgres (required). Local Docker: docker compose up -d
# Neon / Vercel Postgres: paste the pooled connection string.
DATABASE_URL="postgresql://pooldesign:pooldesign@localhost:5432/pooldesign?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
SESSION_SECRET="change-me-in-production-use-a-long-random-string"

# Required in production: Vercel Blob for proposal PNG stills (never store images in Postgres).
# Create a store in Vercel → Storage → Blob, then paste the read/write token.
# BLOB_READ_WRITE_TOKEN=""

