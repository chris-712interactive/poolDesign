{
  "name": "pool-design",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @pool-design/web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @pool-design/db generate",
    "db:push": "pnpm --filter @pool-design/db push",
    "db:seed": "pnpm --filter @pool-design/db seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @pool-design/shared test && pnpm --filter @pool-design/web test"
  }
}
