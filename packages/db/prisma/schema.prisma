generator client {
  provider      = "prisma-client-js"
  // Stable path so Next.js/Vercel can trace & ship the query engine binary.
  output        = "../src/generated/client"
  // native = local; rhel-openssl-3.0.x = Vercel / AWS Lambda Node runtimes
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  platform_owner
  company_admin
  designer
  estimator
}

enum DesignLevel {
  residential
  commercial
  water_park
}

enum UnitSystem {
  imperial
  metric
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  suspended
}

enum MilestoneState {
  pending
  in_progress
  completed
  dismissed
}

enum MilestoneSource {
  system
  owner
}

model Company {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  customDomain         String?            @unique
  defaultUnitSystem    UnitSystem         @default(imperial)
  enabledDesignLevels  String             @default("residential,commercial,water_park")
  logoUrl              String?
  region               String?
  subscriptionStatus   SubscriptionStatus @default(trialing)
  planKey              String             @default("starter")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeConnectId      String?
  trialEndsAt          DateTime?
  setupCompletedAt     DateTime?
  /** Extra designer seats billed on Stripe (beyond the one included seat). */
  designerSeatsPaid    Int                @default(0)
  stripeDesignerItemId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users             User[]
  projects          Project[]
  milestoneStatuses CompanyMilestoneStatus[]
  priceOverrides    CompanyPriceOverride[]
  invites           CompanyInvite[]
  roleGrants        UserRoleGrant[]
  seatCheckouts     SeatCheckout[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole
  /** Company admin who also takes a designer seat (opens CAD). */
  alsoDesigner Boolean    @default(false)
  companyId    String?
  unitSystem   UnitSystem @default(imperial)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleGrants UserRoleGrant[]

  @@index([companyId])
}

model Project {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  clientName  String?
  address     String?
  designLevel DesignLevel @default(residential)
  unitSystem  UnitSystem  @default(imperial)
  /** JSON DesignDocument */
  designJson  String      @default("{}")
  /** Monotonic revision for optimistic save / collab conflict detection */
  designRevision Int      @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shares      ProjectShare[]
  liveSession ProjectLiveSession?

  @@index([companyId])
}

/** Host-driven kitchen-table live session (finish swaps + approvals). */
model ProjectLiveSession {
  id         String   @id @default(cuid())
  projectId  String   @unique
  active     Boolean  @default(false)
  hostUserId String?
  /** JSON LiveSessionState */
  stateJson  String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/** Public client proposal link (no login required). */
model ProjectShare {
  id                 String    @id @default(cuid())
  projectId          String
  token              String    @unique
  includeEstimate    Boolean   @default(true)
  /** Snapshot of design JSON at share time */
  designSnapshotJson String
  /** Snapshot of takeoff JSON at share time (optional) */
  estimateSnapshotJson String?
  /** Public URL or data-URL for a 3D still */
  previewImageUrl    String?
  /** Optional orbit clip URL */
  previewVideoUrl    String?
  createdByUserId    String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([token])
}

/** Staff roles on a company user. A person may hold more than one. */
model UserRoleGrant {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([companyId, role])
  @@index([userId])
}

/** Checkout in flight for a paid designer seat assigned to a user. */
model SeatCheckout {
  id              String   @id @default(cuid())
  companyId       String
  userId          String
  role            UserRole @default(designer)
  stripeSessionId String   @unique
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
}

/** Per-company catalog unit price overrides (cents). */
model CompanyPriceOverride {
  id              String   @id @default(cuid())
  companyId       String
  catalogItemId   String
  unitPriceCents  Int
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, catalogItemId])
  @@index([companyId])
}

/** Pending team invite (email + temp password until accepted). */
model CompanyInvite {
  id              String    @id @default(cuid())
  companyId       String
  email           String
  name            String
  role            UserRole  @default(designer)
  token           String    @unique
  temporaryPasswordHash String
  invitedByUserId String?
  acceptedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model OnboardingMilestone {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  sortOrder   Int

  statuses CompanyMilestoneStatus[]
}

model CompanyMilestoneStatus {
  id          String          @id @default(cuid())
  companyId   String
  milestoneId String
  state       MilestoneState  @default(pending)
  source      MilestoneSource?
  note        String?
  updatedBy   String?
  completedAt DateTime?
  dismissedAt DateTime?
  updatedAt   DateTime        @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  milestone OnboardingMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([companyId, milestoneId])
  @@index([companyId])
}
